{
  "manifest_version": 3,
  "name": "Sentinel — Email Threat Detector",
  "version": "1.0.0",
  "description": "Real-time Gmail threat detection powered by Sentinel AI forensics.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon":  "icons/icon48.png",
    "default_title": "Sentinel Threat Detector"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js":      ["content.js"],
      "css":     ["content.css"],
      "run_at":  "document_idle"
    }
  ],

  "permissions": [
    "identity",
    "storage",
    "alarms",
    "notifications",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://mail.google.com/*",
    "https://www.googleapis.com/*",
    "https://gmail.googleapis.com/*",
    "http://localhost:8000/*",
    "https://localhost:8000/*"
  ],

  "oauth2": {
    "client_id": "857034958455-fmboilbtvos840o7sn1jcpasah1h6fme.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly",
      "https://www.googleapis.com/auth/gmail.labels",
      "https://www.googleapis.com/auth/gmail.modify",
      "openid",
      "email",
      "profile"
    ]
  },

  "web_accessible_resources": [
    {
      "resources": ["icons/*.png", "content.css"],
      "matches":   ["https://mail.google.com/*"]
    }
  ]
}